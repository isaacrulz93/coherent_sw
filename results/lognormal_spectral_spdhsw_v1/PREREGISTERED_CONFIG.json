{
  "version": "lognormal_spectral_spdhsw_v1",
  "created_before_implementation_tests_or_new_outcomes": true,
  "branch": "exp/lognormal-spectral-spdhsw-v1",
  "dtype": "torch.float64",
  "amp": false,
  "autocast": false,
  "tf32": false,
  "physical_gpu": 3,
  "gpu_availability_at_audit": "available; 15 MiB total use, Xorg 4 MiB, no compute process",
  "spectral_sigma_grid": [0.0, 0.5, 1.0, 1.25, 1.5],
  "hierarchy": {
    "bottleneck_k": 40,
    "final_L": 500,
    "fresh_bank_and_mix_every_epoch": true,
    "orthogonalization": false,
    "materialize_effective_directions_in_training": false
  },
  "phase_A": {
    "ambient_dimensions": [253, 2016, 8256],
    "draws_per_dimension": 200,
    "comparators": [
      "direct_uniform_k40",
      "direct_lognormal_spectral_k40",
      "hierarchical_uniform_L500",
      "hierarchical_lognormal_spectral_L500",
      "best_of_L500",
      "within_span_oracle"
    ],
    "gate": {
      "sigma_zero_reproduces_uniform": true,
      "positive_interaction_every_dimension_for_one_registered_nonzero_sigma": true,
      "not_only_ill_conditioned_subset": true,
      "no_numerical_instability": true
    }
  },
  "phase_B": {
    "dataset": "Schirrmeister2017",
    "subjects": [2, 3, 4],
    "seed": 6398,
    "epochs": 100,
    "lew_every": 25,
    "p": 2,
    "control": "normalized_update",
    "step_target": "median initial normalized-SPDHSW raw-LR-10000 update norm over subjects 2,3,4",
    "methods": [
      "normalized_spdhsw_k40_l500",
      "lns_spdhsw_k40_l500_s{0.5,1.0,1.25,1.5}",
      "spdsw_l40",
      "direct_lns_l40_s{0.5,1.0,1.25,1.5}",
      "spdsw_l500"
    ],
    "selection": "no divergence, then lowest mean relative LEW AUC, tie toward smaller sigma",
    "gate": "selected nonzero sigma improves normalized AUC over sigma=0 on at least 2 of 3 subjects"
  },
  "phase_C": {
    "conditional_on_phase_B": true,
    "subjects": [1, 7, 14],
    "seeds": [6398, 3654, 1788],
    "epochs": 500,
    "lew_every": 25,
    "controls": ["normalized_update", "raw_sgd_initial_update_matched"],
    "raw_lr_grid": [1000.0, 3000.0, 5000.0, 10000.0],
    "raw_lr_selection_uses_lew": false,
    "methods": [
      "spdsw_l40",
      "direct_lns_l40_s{selected}",
      "normalized_spdhsw_k40_l500",
      "lns_spdhsw_k40_l500_s{selected}",
      "spdsw_l500"
    ]
  },
  "phase_D": {
    "conditional_on_all_phase_C_gate_items": true,
    "automatic_full_HGD_expansion": false,
    "BNCI_subjects_if_pass": [1, 3, 8],
    "BNCI_seeds_if_pass": [6398]
  },
  "prohibited": [
    "hidden clipping or gradient clipping",
    "early stopping",
    "preprocessing or LEW changes",
    "post-hoc sigma expansion",
    "persistent/evolving bank",
    "automatic full HGD 14-subject expansion"
  ]
}
